# Copy to .env and fill in. .env is gitignored; this file is not, so it must never
# contain a real key.
#
#   cp .env.example .env && chmod 600 .env

# GitHub GraphQL and REST: PR reviews, issue response times, releases, archivedAt.
GITHUB_TOKEN=

# CrOSSD public API. No token needed.
CROSSD_API=https://health.crossd.tech/api

# Only if deps.dev or GH Archive are read through BigQuery.
GOOGLE_CLOUD_PROJECT=
